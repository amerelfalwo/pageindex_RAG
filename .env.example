
PAGEINDEX_API_KEY_1=your_first_key
PAGEINDEX_API_KEY_2=your_second_key
PAGEINDEX_API_KEY_3=your_third_key


HF_TOKEN=hf_your_free_token_here

HF_RETRIEVAL_MODEL=meta-llama/Llama-3.1-8B-Instruct
HF_CHAT_MODEL=meta-llama/Llama-3.1-8B-Instruct

GROQ_API_KEY=gsk_your_key_here
GROQ_CHAT_MODEL=qwen/qwen3.8-27b
GROQ_RETRIEVAL_MODEL=qwen/qwen3.8-27b

# PostgreSQL Database Persistence (Local Docker or Cloud: Neon, Supabase, Railway)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rag_pageindex

# CORS Allowed Origins (Comma-separated list of origins. In production set to your frontend domain)
CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:3000

# Rate Limiting (Requests per minute per client_id / IP)
RATE_LIMIT_ASK_PER_MIN=20
RATE_LIMIT_UPLOAD_PER_MIN=5
RATE_LIMIT_QUIZ_PER_MIN=5
RATE_LIMIT_TOOLS_PER_MIN=20

# Upload and Security Constraints
MAX_FILE_SIZE_MB=20
MAX_WEB_PAGE_BYTES=2097152
ATLAS_MCP_INTERNAL_TOOLS=false